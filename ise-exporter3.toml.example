# ise-exporter3 configuration.
#
# Run `ise-exporter3 plan --config <this file>` to see exactly which source will
# supply each dataset and what it will cost each ISE persona per hour. That
# command needs no credentials and no appliance, so you can check a configuration
# before pointing it at production.
#
# Passwords are never written here. They come from the environment:
#   ISE_PASS                     the PAN/MnT read-only account
#   ISE_DATACONNECT_PASSWORD     the fixed `dataconnect` Oracle account
#   ISE_PXGRID_PASSWORD          only when using password-based pxGrid auth
# Native systemd installs set these through `ise-exporter3-set-passwords`, which
# maintains /etc/ise-exporter3/credentials as a root-only EnvironmentFile.

# Fleet size and spending ceilings. "production" (the default, sized for
# ~100k endpoints / ~5k NADs) or "lab". Anything below overrides it.
profile = "production"

[exporter]
port = 9618                                   # Prometheus scrape listener
api_host = "127.0.0.1"                        # operator API; localhost by default
api_port = 9619
state_db = "/var/lib/ise-exporter3/state.sqlite3"
log_level = "INFO"
# A plan over budget is a configuration error, not a production surprise. Set
# false to downgrade it to a startup warning -- and to stop the runtime from
# throttling requests to the declared rate, since both are the same statement:
# do not enforce what [budget] says.
enforce_budget = true

# How big this deployment is. Costs that scale with the fleet are resolved
# against these numbers, so the plan is predictive for *your* estate.
# `ise-exporter3 plan --live-scale` pulls all five as bounded live counts,
# explains their sources, and previews the plan without changing this file.
[scale]
nads = 5000        # configured switches, WLCs, VPN headends, and other AAA NADs
endpoints = 100000 # endpoint-database records, including inactive devices
sessions = 20000   # active RADIUS sessions now; not unique endpoints or users
accounts = 1000    # ISE Internal Users records; excludes external AD/LDAP users
policy_sets = 100  # Device Admin TACACS+ policy sets, not rules inside the sets

# ---------------------------------------------------------------------------
# Targets: which ISE personas can be reached, and as whom.
# A dataset whose provider targets an unconfigured persona is reported by `plan`
# as unavailable, by name, instead of silently producing an empty panel.
# ---------------------------------------------------------------------------

[targets.pan]
host = "pan1.example.com"
user = "ers.readonly"
ers_port = 9060
ca_bundle = "/etc/ise-exporter3/certs/ise-rest-ca.pem"
verify_tls = true

[targets.mnt]
# Authenticates with the PAN account above; no separate credential.
host = "mnt1.example.com"
ca_bundle = "/etc/ise-exporter3/certs/ise-mnt-ca.pem"
verify_tls = true

[targets.oracle]
# Data Connect. ISE fixes the user, service name and port; they are not ordinary
# Oracle settings. Must be the *active* Data Connect MnT, and must be the
# hostname on that node's Admin certificate.
host = "mnt1.example.com"
port = 2484
service = "cpm10"
user = "dataconnect"
ca_bundle = "/etc/ise-exporter3/certs/ise-dataconnect-ca.pem"
verify_tls = true

[targets.pxgrid]
# Optional. Supplies live sessions and the endpoint attributes (model, OS, MDM)
# that no Data Connect view carries. Leave the host empty to run without it:
# datasets that can fall back will say so in `plan`.
host = ""
port = 8910
node_name = "ise-exporter"
client_cert = ""
client_key = ""
ca_bundle = ""
verify_tls = true
request_timeout = 30

# ---------------------------------------------------------------------------
# Budget: the ceiling per target. This is what makes load a decision rather
# than a discovery. Pacing, cooldowns and query timeouts are all derived from
# these plus each provider's declared cost -- they are not knobs.
#
# These are ENFORCED, not merely measured: a token bucket per target makes a
# request wait rather than exceed the rate declared here. That matters most on a
# cold start, which is the one case where the difference showed -- warming the
# session cache for 20,000 endpoints ran at ~11,300 req/h against this 4,000
# ceiling for its first two hours, and the appliance silently absorbed it.
# `exporter.enforce_budget = false` turns enforcement back into observation.
# ---------------------------------------------------------------------------

[budget]
pan.requests_per_hour = 3000
# Sized for full per-endpoint coverage rather than a sample. See
# `plan` for the warm-up burst and time to full coverage.
mnt.requests_per_hour = 4000
pxgrid.requests_per_hour = 200

# Cold start versus steady state is a real decision, so it is one you make here
# rather than one the exporter makes quietly. Left unset, a filling cache runs at
# the steady ceiling above and simply takes longer; `plan` prints how long, and
# `ise3_detail_fetches_deferred` stays above zero until it is done.
#
# At the scale declared above, full session coverage takes ~12.7h inside the
# 4,000/h ceiling. Uncommenting the line below spends 12,000/h while any MnT
# cache is still filling -- 3x the steady ceiling, for roughly two hours -- and
# `plan` prints that as a decision with its duration. Nothing bursts once warm.
#
# mnt.warmup_requests_per_hour = 12000

# Oracle takes no warm-up burst: it is budgeted as a duty cycle, and no Data
# Connect provider caches per-entity detail. Declaring one is a config error.
# Oracle is budgeted as a duty cycle: the share of wall-clock time the exporter
# may keep a Data Connect statement running. The complete dashboard-parity set
# declares ~2.64% at production scale, so 3% is the large-estate default.
oracle.duty_cycle_percent = 3.0

# ---------------------------------------------------------------------------
# Limits: what one statement, one batch and one snapshot may return.
#
# Every value here is DERIVED from [scale] above and printed by `plan`, so you
# should not normally need this section at all -- it is written out because a
# ceiling you cannot see is a surprise waiting for an estate large enough to
# find it. That is not hypothetical: these used to be constants in three
# different modules, and they contradicted each other. A statement was capped at
# 5,500 groups, a batch at five statements, and a batch result at 12,000 rows --
# smaller than three full-size statements -- so `tacacs_activity` failed every
# collection at this scale, after paying for the Oracle scans each time.
#
# The chain, and it is checked at start:
#
#   group_ceiling      = nads + accounts + 500   (marginals add, they multiply
#                                                 nothing, so this is the sum)
#   result_rows        = group_ceiling + 500     (a statement returning every
#                                                 group it asked for is a success)
#   batch_result_rows  = result_rows x batch_queries
#
# At the scale declared above that resolves to 6,500 / 7,000 / 35,000. Setting
# any of them by hand is allowed and warns at start; setting them into a
# contradiction is refused outright rather than found in production. Hard floors
# and caps are in code and are not settable.
#
# [limits]
# group_ceiling = 6500
# result_rows = 7000
# batch_queries = 5
# batch_result_rows = 35000
# result_bytes = 67108864         # the real safety bound; 35,000 rows is ~7 MB
# window_hours = 6                # how far back any event statement may scan
# snapshot_samples = 50000        # hard: one dataset publishing more fails
# snapshot_sample_warning = 20000 # soft: logged, so width is seen before it bites

# ---------------------------------------------------------------------------
# Datasets: enabled, providers, interval, and options. All are optional;
# omit a dataset entirely to take its defaults. `providers` is an ordered
# preference list: the first one whose target is reachable wins, and the runtime
# exports which one is live. Because sources differ in meaning, `provider` is a
# label on the data, and dashboards gate on it.
#
# `options` is where a dataset declares any bound it puts on its own breakdowns.
# There is deliberately nowhere else to put one: a top-K that lives as a constant
# in a collector produces a panel that looks like the fleet and is the busiest
# slice of it. `plan` prints every option below its value and its meaning, and
# every bounded breakdown exports ise3_topk_groups_returned against
# ise3_topk_groups_total.
# ---------------------------------------------------------------------------

[datasets.active_sessions]
# pxGrid is nearest to real time and cheapest; MnT is authoritative for PSN;
# Data Connect reconstructs from accounting and is by far the most expensive.
providers = ["pxgrid", "mnt", "dataconnect"]
interval = "5m"

[datasets.endpoint_attributes]
# Model / OS / MDM exist only on pxGrid, and deliberately have no fallback: the
# ERS alternative supplied `profile` alone, which endpoint_inventory already
# covers from one Data Connect query, and at 100k endpoints it could not keep a
# cache warm inside the PAN budget. Without pxGrid configured this dataset is
# unavailable, and `plan` says so by name.
providers = ["pxgrid"]
interval = "6h"

[datasets.endpoint_inventory]
# Data Connect aggregates server-side and is nearly flat in fleet size. The ERS
# fallback pages at 100 rows -- roughly 1000 PAN requests at 100k endpoints.
providers = ["dataconnect", "ers"]
interval = "6h"

[datasets.profile_events]
# Historical profiling source/action changes, distinct from the current endpoint
# inventory snapshot above.
interval = "6h"

[datasets.radius_reporting]
interval = "30m"

[datasets.radius_accounting]
# Accounting is event history, not the current-session directory. It supplies
# start/stop volume, per-NAD and per-PSN accounting, and completed-session
# duration without changing what `active_sessions` means.
interval = "30m"

[datasets.nad_health]
interval = "6h"

# The two settings below are what `plan` talked us out of. At the tempting
# psn_performance = "5m" and source_freshness = "30m", the oracle target lands at
# 2.44% duty against the old 2.0% ceiling -- psn_performance alone is 1.0% of it.
# The shipped 3.0% ceiling now also honestly funds converging policy-rule
# inventory without weakening those operational cadences. This example retains
# the original explanation because it documents why the tempting values below
# are still rejected.
# is the v2 failure mode in miniature: cadences that read as operational in the
# config but are throttled to fiction at runtime. Slowing the PSN rollup to 10m
# and demoting the freshness probe to 6h brings the plan to ~1.7% and makes every
# stated cadence one the exporter can actually keep.
[datasets.psn_performance]
interval = "10m"

[datasets.source_freshness]
interval = "6h"

# TACACS activity has two large dimensions -- one group per Device Admin account
# and one per device doing Device Admin -- so it is the one dataset whose device
# breakdown is bounded, and this is where that decision lives.
#
# The scan stays complete either way: every device is counted, rolled up to its
# ops owner, and the individual devices published are the worst offenders. What
# `top_devices` chooses is how many of them get their own time series.
#
#   200 (the default)  ~2,400 series for this dataset; a Device Admin dashboard
#                      wants "who logged in to what, and what failed"
#   0                  every device: ~25,000 series at 5,000 NADs, which is the
#                      largest metric family in the exporter. Legal, honoured,
#                      and warned about at start
#
# Either way ise3_topk_groups_returned / _total / ise3_topk_truncated say what
# the panel is showing against what exists.
[datasets.tacacs_activity.options]
device_rollup = true
top_devices = 200

# Example of turning something off: TACACS costs a large ERS walk plus a
# reporting scan, and is dead weight if Device Administration is not in use.
# [datasets.tacacs_config]
# enabled = false
# [datasets.tacacs_policy_rules]
# enabled = false
# [datasets.tacacs_activity]
# enabled = false
