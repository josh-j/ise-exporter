{
  "annotations": {},
  "description": "Which source supplies each dataset, when it changed, and why. A fallback may answer a narrower question than the preferred source.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "ise-exporter3"
      ],
      "targetBlank": false,
      "title": "ISE Exporter 3 dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": [],
      "title": "Active source",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "The provider currently supplying each dataset; a missing row means no provider is usable.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataset_provider_active{instance=~\"$deployment\"} == 1",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{provider}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Live source per dataset",
      "transformations": [],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Non-zero means a dataset fell back, making a change in data semantics visible rather than silent.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum(ise3_dataset_provider_degraded{instance=~\"$deployment\"})",
          "instant": false,
          "legendFormat": "degraded",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "ise3_dataset_provider_degraded{instance=~\"$deployment\"} == 1",
          "instant": false,
          "legendFormat": "{{dataset}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Datasets not on their preferred source",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 0,
      "panels": [],
      "title": "Why it changed",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Bounded reason recorded when a dataset stepped to a different provider.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataset_provider_reason_info{instance=~\"$deployment\"} == 1",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{provider}} \u00b7 {{reason}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Reason each fallback engaged",
      "transformations": [],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Configured sources this build cannot run because a target, capability, or reporting view is unavailable.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataset_provider_available{instance=~\"$deployment\"} == 0",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{provider}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Declared but unusable sources",
      "transformations": [],
      "transparent": false,
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 0,
      "panels": [],
      "title": "Collection",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Last-attempt success and freshness for each active dataset provider.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataset_up{instance=~\"$deployment\"}",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{provider}} up",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "ise3_dataset_fresh{instance=~\"$deployment\"}",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{provider}} fresh",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Dataset health",
      "transformations": [],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "One bounded operator explanation per failing dataset; empty is the healthy state.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataset_last_failure_detail_info{instance=~\"$deployment\"} == 1",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{reason}} \u00b7 {{detail}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Latest failure per dataset",
      "transformations": [],
      "transparent": false,
      "type": "table"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 36,
  "style": "dark",
  "tags": [
    "ise",
    "ise-exporter3"
  ],
  "templating": {
    "list": [
      {
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "hide": 0,
        "id": "00000000-0000-0000-0000-000000000000",
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "prometheus",
        "query": "prometheus",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "hide": 0,
        "id": "00000000-0000-0000-0000-000000000000",
        "includeAll": true,
        "label": "Deployment",
        "multi": true,
        "name": "deployment",
        "query": "label_values(ise3_dataset_enabled, instance)",
        "skipUrlSync": false,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "ISE Exporter 3 \u2014 Sources",
  "uid": "ise3-sources"
}
