      "id": 0,
      "panels": [],
      "title": "PSN service",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Freshness of deployment, performance, session, reporting, accounting, and error datasets used here.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"deployment\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"deployment\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"deployment\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"deployment\"} == 1))) == 1)",
          "instant": true,
          "legendFormat": "deployment",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"psn_performance\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"psn_performance\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"psn_performance\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"psn_performance\"} == 1))) == 1)",
          "instant": true,
          "legendFormat": "performance",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"active_sessions\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"active_sessions\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"active_sessions\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"active_sessions\"} == 1))) == 1)",
          "instant": true,
          "legendFormat": "sessions",
          "range": false,
          "refId": "C"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"radius_reporting\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"radius_reporting\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"radius_reporting\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"radius_reporting\"} == 1))) == 1)",
          "instant": true,
          "legendFormat": "RADIUS",
          "range": false,
          "refId": "D"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"radius_errors\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"radius_errors\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"radius_errors\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"radius_errors\"} == 1))) == 1)",
          "instant": true,
          "legendFormat": "errors",
          "range": false,
          "refId": "E"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"radius_accounting\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"radius_accounting\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"radius_accounting\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"radius_accounting\"} == 1))) == 1)",
          "instant": true,
          "legendFormat": "accounting",
          "range": false,
          "refId": "F"
        }
      ],
      "title": "Dataset readiness",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Seconds since the latest successful performance, session, RADIUS, and deployment snapshots used here.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "time() - ise3_dataset_last_success_timestamp{instance=~\"$deployment\",dataset=\"psn_performance\"}",
          "instant": true,
          "legendFormat": "performance",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "time() - ise3_dataset_last_success_timestamp{instance=~\"$deployment\",dataset=\"active_sessions\"}",
          "instant": true,
          "legendFormat": "sessions",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "time() - ise3_dataset_last_success_timestamp{instance=~\"$deployment\",dataset=\"radius_reporting\"}",
          "instant": true,
          "legendFormat": "RADIUS",
          "range": false,
          "refId": "C"
        },
        {
          "expr": "time() - ise3_dataset_last_success_timestamp{instance=~\"$deployment\",dataset=\"deployment\"}",
          "instant": true,
          "legendFormat": "deployment",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "Dataset collection age",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "PSNs represented in performance reporting beside AAA and system diagnostic events in the bounded reporting window.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "count(ise3_psn_radius_requests_per_hour{instance=~\"$deployment\",node=~\"$node\"})",
          "instant": true,
          "legendFormat": "reporting nodes",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "sum(ise3_psn_diagnostic_events_total{instance=~\"$deployment\"})",
          "instant": true,
          "legendFormat": "diagnostic events",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Reporting nodes and diagnostic events",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Missing required columns in core PSN reporting views and in the optional AAA/system diagnostic views. Core must be zero; diagnostic gaps explain reduced work-queue coverage without failing performance collection.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum(1 - ise3_dataconnect_schema_column_available{instance=~\"$deployment\",view=~\"KEY_PERFORMANCE_METRICS|SYSTEM_SUMMARY\",requirement=\"required\"})",
          "instant": true,
          "legendFormat": "core gaps",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "sum(1 - ise3_dataconnect_schema_column_available{instance=~\"$deployment\",view=~\"AAA_DIAGNOSTICS_VIEW|SYSTEM_DIAGNOSTICS_VIEW\",requirement=\"required\"})",
          "instant": true,
          "legendFormat": "diagnostic gaps",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "PSN schema compatibility",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Current active-session count by serving policy service node from sources that carry a PSN field.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(ise3_active_sessions_by_psn{instance=~\"$deployment\",psn=~\"$node\"}) and on(instance) (((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"active_sessions\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"active_sessions\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"active_sessions\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"active_sessions\"} == 1))) == 1))",
          "instant": false,
          "legendFormat": "{{psn}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Active sessions per PSN",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Change in active sessions over five minutes by PSN, highlighting abrupt load movement.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "delta(ise3_active_sessions_by_psn{instance=~\"$deployment\",psn=~\"$node\"}[5m])",
          "instant": false,
          "legendFormat": "{{psn}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Session delta per PSN",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
