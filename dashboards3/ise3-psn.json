{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "changes(ise3_dataset_provider_active[5m]) > 0",
        "hide": false,
        "iconColor": "purple",
        "name": "Provider changed",
        "step": "1m",
        "textFormat": "{{dataset}} is now served by {{provider}}",
        "titleFormat": "Provider changed: {{dataset}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "max by (node) (changes(ise3_deployment_node_state[10m])) > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Node state changed",
        "step": "1m",
        "textFormat": "{{node}} changed deployment state",
        "titleFormat": "Node state changed: {{node}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "ise3_exporter_build_info unless (ise3_exporter_build_info offset 5m)",
        "hide": false,
        "iconColor": "blue",
        "name": "Exporter build changed",
        "step": "1m",
        "textFormat": "exporter {{version}} targeting ISE {{target_ise_release}}",
        "titleFormat": "Exporter build changed"
      }
    ]
  },
  "description": "Tier 2 diagnostic. Are the policy service nodes coping? Service level first, then utilisation and saturation per node, then the reporting pipeline those nodes feed.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "ise-exporter3"
      ],
      "targetBlank": false,
      "title": "ISE Exporter 3 dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": [],
      "title": "Service level",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Highest RADIUS load percentage reported by any selected PSN \u2014 the saturation signal of USE for this service. Amber at 80%, red at 90%: past that, latency rises before throughput falls, so this leads the symptom.",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "noValue": "no data \u2014 stale, see Collection pipeline",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max((ise3_psn_load_percent{node=~\"$node\"}) and on() (((max(ise3_dataset_up{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1)))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Busiest node load",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Slowest average RADIUS latency across the selected PSNs. A single slow node is that node's resources or identity-store path; all of them slow together is the identity store itself.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 stale, see Collection pipeline",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max((ise3_psn_average_latency_seconds{node=~\"$node\"}) and on() (((max(ise3_dataset_up{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1)))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Worst node latency",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Combined RADIUS request rate across the selected PSNs, as ISE itself reports it. The throughput half of the picture: read it beside load to tell a busy deployment from a struggling one.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 stale, see Collection pipeline",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum((ise3_psn_radius_requests_per_hour{node=~\"$node\"}) and on() (((max(ise3_dataset_up{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1)))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "RADIUS requests per hour",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Diagnostic events ISE raised on the selected PSNs in the window. Not all are errors, but a step change is worth reading \u2014 the diagnostic work queue below names them.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 stale, see Collection pipeline",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum((ise3_psn_diagnostic_events_total) and on() (((max(ise3_dataset_up{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1)))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Diagnostic events",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Share of this dashboard's own datasets that both collected successfully and are inside their freshness window (active_sessions, psn_performance). Below 100% means some panel here is blank or stale, and the pipeline dashboard says which.",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": false,
              "title": "Why \u2014 collection pipeline",
              "url": "/d/ise3-pipeline?${__url_time_range}"
            }
          ],
          "max": 1,
          "min": 0,
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "avg(((max by (dataset) (ise3_dataset_up{dataset=~\"psn_performance|active_sessions\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=~\"psn_performance|active_sessions\"} == 1))) == bool 1) * ((max by (dataset) (ise3_dataset_fresh{dataset=~\"psn_performance|active_sessions\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=~\"psn_performance|active_sessions\"} == 1))) == bool 1))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Data trustworthy",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Time since the least recently collected of this dashboard's datasets last succeeded. Every number on this page is at least this old; a value climbing past its collection interval means ISE is answering slowly or not at all.",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": false,
              "title": "Why \u2014 collection pipeline",
              "url": "/d/ise3-pipeline?${__url_time_range}"
            }
          ],
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max(time() - (max by (dataset) (ise3_dataset_last_success_timestamp{dataset=~\"psn_performance|active_sessions\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=~\"psn_performance|active_sessions\"} == 1))))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Collection age",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 0,
      "panels": [],
      "title": "Throughput",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Live sessions each PSN is holding. Nodes that should be load-balanced equally and are not point at the network devices' RADIUS server ordering rather than at ISE.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(ise3_active_sessions_by_psn) and on() (((max(ise3_dataset_up{dataset=\"active_sessions\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"active_sessions\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"active_sessions\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"active_sessions\"} == 1))) == 1))",
          "instant": false,
          "legendFormat": "{{psn}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Active sessions per PSN",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Change in each PSN's session count over 15m. Flat is the normal state, including at the busiest hour of the day: a PSN that is holding steady under load reads the same here as one holding steady at midnight. A fall on one node matched by a rise on another is load moving between them, which is what a failover, a node restart, or a NAD's RADIUS server order changing looks like from here. A fall with no matching rise is sessions leaving ISE rather than moving inside it \u2014 read it beside the total on Access. Blank for the first 15m after an exporter restart, and for a PSN that has been serving for less than that: there is no earlier count to subtract yet.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "text",
                "value": 0
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(ise3_active_sessions_by_psn - ise3_active_sessions_by_psn offset 15m) and on() (((max(ise3_dataset_up{dataset=\"active_sessions\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"active_sessions\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"active_sessions\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"active_sessions\"} == 1))) == 1))",
          "instant": false,
          "legendFormat": "{{psn}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Session delta per PSN",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Per-node request rate over time. Compare the shape against active sessions: rate rising while sessions stay flat is re-authentication churn, not growth.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(ise3_psn_radius_requests_per_hour{node=~\"$node\"}) and on() (((max(ise3_dataset_up{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1))",
          "instant": false,
          "legendFormat": "{{node}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "RADIUS requests per hour by PSN",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 0,
      "panels": [],
      "title": "Utilisation and saturation",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Per-node CPU as ISE reports it, with the amber and red thresholds drawn. Sustained time above 80% is the point at which authentication latency starts to move.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(ise3_node_cpu_utilization_percent{node=~\"$node\"}) and on() (((max(ise3_dataset_up{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1))",
          "instant": false,
          "legendFormat": "{{node}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CPU utilisation",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Per-node memory as ISE reports it. A node climbing steadily without a matching rise in sessions is usually a leak or a log-processing backlog rather than load.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(ise3_node_memory_utilization_percent{node=~\"$node\"}) and on() (((max(ise3_dataset_up{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1))",
          "instant": false,
          "legendFormat": "{{node}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Memory utilisation",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "The fullest filesystem on each node. ISE degrades badly when a node runs out of disk \u2014 logging stops first, then services \u2014 so this is a saturation signal worth watching ahead of CPU.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "options": {
        "legend": {
          "calcs": [
