          "instant": false,
          "legendFormat": "{{value}} \u00b7 {{event_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Accounting events per PSN",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
