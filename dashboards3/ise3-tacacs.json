{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "changes(ise3_dataset_provider_active[5m]) > 0",
        "hide": false,
        "iconColor": "purple",
        "name": "Provider changed",
        "step": "1m",
        "textFormat": "{{dataset}} is now served by {{provider}}",
        "titleFormat": "Provider changed: {{dataset}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "max by (node) (changes(ise3_deployment_node_state[10m])) > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Node state changed",
        "step": "1m",
        "textFormat": "{{node}} changed deployment state",
        "titleFormat": "Node state changed: {{node}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "ise3_exporter_build_info unless (ise3_exporter_build_info offset 5m)",
        "hide": false,
        "iconColor": "blue",
        "name": "Exporter build changed",
        "step": "1m",
        "textFormat": "exporter {{version}} targeting ISE {{target_ise_release}}",
        "titleFormat": "Exporter build changed"
      }
    ]
  },
  "description": "Tier 2 diagnostic. Who is administering the network devices over TACACS+, are they succeeding, and is the account estate behind it clean? Activity first, then accounts and devices, then hygiene and policy.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "ise-exporter3"
      ],
      "targetBlank": false,
      "title": "ISE Exporter 3 dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": [],
      "title": "Device administration activity",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Share of TACACS+ device administration logins that succeeded. Unlike RADIUS, a low rate here is usually a small number of people getting it wrong rather than a systemic fault \u2014 read the per-account table before escalating.",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "noValue": "no data \u2014 stale, see Collection pipeline",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.85
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(sum((ise3_tacacs_authentications{dimension=\"username\",status=\"passed\"}) and on() (((max(ise3_dataset_up{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1)))) / clamp_min((sum((ise3_tacacs_authentications{dimension=\"username\"}) and on() (((max(ise3_dataset_up{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1)))), 1)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Authentication success rate",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "TACACS+ authorization decisions in the window. A step change without a matching change in authentications means shell profiles or command sets changed, not the number of people logging in.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 stale, see Collection pipeline",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum((ise3_tacacs_authorizations{dimension=\"username\"}) and on() (((max(ise3_dataset_up{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1)))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Authorizations",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Commands recorded by TACACS+ accounting. This is the audit trail; a collapse to zero while authentications continue means command accounting has been switched off somewhere.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 stale, see Collection pipeline",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum((ise3_tacacs_commands{dimension=\"username\"}) and on() (((max(ise3_dataset_up{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1)))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Commands accounted",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Internal device-administration accounts configured in ISE, and how many showed activity in the window. A large gap between the two is the hygiene problem the review queue below enumerates.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 stale, see Collection pipeline",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(ise3_tacacs_internal_accounts) and on() (((max(ise3_dataset_up{dataset=\"tacacs_config\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_config\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"tacacs_config\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_config\"} == 1))) == 1))",
          "instant": true,
          "legendFormat": "configured",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "(ise3_tacacs_active_accounts) and on() (((max(ise3_dataset_up{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1))",
          "instant": true,
          "legendFormat": "active",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Internal accounts",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Share of this dashboard's own datasets that both collected successfully and are inside their freshness window (tacacs_activity, tacacs_config). Below 100% means some panel here is blank or stale, and the pipeline dashboard says which.",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": false,
              "title": "Why \u2014 collection pipeline",
              "url": "/d/ise3-pipeline?${__url_time_range}"
            }
          ],
          "max": 1,
          "min": 0,
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "avg(((max by (dataset) (ise3_dataset_up{dataset=~\"tacacs_activity|tacacs_config\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=~\"tacacs_activity|tacacs_config\"} == 1))) == bool 1) * ((max by (dataset) (ise3_dataset_fresh{dataset=~\"tacacs_activity|tacacs_config\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=~\"tacacs_activity|tacacs_config\"} == 1))) == bool 1))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Data trustworthy",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Time since the least recently collected of this dashboard's datasets last succeeded. Every number on this page is at least this old; a value climbing past its collection interval means ISE is answering slowly or not at all.",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": false,
              "title": "Why \u2014 collection pipeline",
              "url": "/d/ise3-pipeline?${__url_time_range}"
            }
          ],
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max(time() - (max by (dataset) (ise3_dataset_last_success_timestamp{dataset=~\"tacacs_activity|tacacs_config\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=~\"tacacs_activity|tacacs_config\"} == 1))))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Collection age",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 0,
      "panels": [],
      "title": "Over time",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "TACACS+ logins by outcome, stacked. Repeated failures from one account are usually a stale saved credential on a jumpbox; failures across many accounts at once are an identity-store problem.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(passed|Passed|compliant|Compliant|success).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(failed|Failed|non-compliant|NonCompliant|error).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(unknown|Unknown|pending|Pending).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "text",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum by (status) ((ise3_tacacs_authentications{dimension=\"username\"}) and on() (((max(ise3_dataset_up{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1)))",
          "instant": false,
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Authentication outcome over time",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Authorization decisions by outcome. Failures here are people being refused a command or a shell profile \u2014 expected in small numbers, worth investigating as a pattern.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(passed|Passed|compliant|Compliant|success).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(failed|Failed|non-compliant|NonCompliant|error).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(unknown|Unknown|pending|Pending).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "text",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum by (status) ((ise3_tacacs_authorizations{dimension=\"username\"}) and on() (((max(ise3_dataset_up{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1)))",
          "instant": false,
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Authorization outcome over time",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 0,
      "panels": [],
      "title": "Who and where",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Every account with device-administration activity in the window, passed and failed. Sorted by failures because that is what needs attention; the whole list is present, so this doubles as the audit answer to 'who logged into the network kit'.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum by (value) ((ise3_tacacs_authentications{dimension=\"username\",status=\"failed\"}) and on() (((max(ise3_dataset_up{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1)))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "sum by (value) ((ise3_tacacs_authentications{dimension=\"username\",status=\"passed\"}) and on() (((max(ise3_dataset_up{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"tacacs_activity\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"tacacs_activity\"} == 1))) == 1)))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Activity by account",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time",
                "__name__",
                "job",
                "instance"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "Failed",
              "Value #B": "Passed",
              "value": "Account"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Failed"
              }
            ]
          }
        }
      ],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Device-administration activity per network device. A device with many failures is often one where the shared secret or the AAA configuration drifted from the template.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "options": null,
      "repeatDirection": "h",
