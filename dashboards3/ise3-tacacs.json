      "id": 0,
      "panels": [],
      "title": "Configuration and account health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Freshness of TACACS configuration and historical activity datasets used by this workflow.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"tacacs_config\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"tacacs_config\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"tacacs_config\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"tacacs_config\"} == 1))) == 1)",
          "instant": true,
          "legendFormat": "configuration",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"tacacs_activity\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"tacacs_activity\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"tacacs_activity\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"tacacs_activity\"} == 1))) == 1)",
          "instant": true,
          "legendFormat": "activity",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"tacacs_policy_rules\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"tacacs_policy_rules\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"tacacs_policy_rules\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"tacacs_policy_rules\"} == 1))) == 1)",
          "instant": true,
          "legendFormat": "policy rules",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Dataset readiness",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Seconds since the latest successful TACACS configuration and historical-activity collections.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "time() - ise3_dataset_last_success_timestamp{instance=~\"$deployment\",dataset=\"tacacs_config\"}",
          "instant": true,
          "legendFormat": "configuration",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "time() - ise3_dataset_last_success_timestamp{instance=~\"$deployment\",dataset=\"tacacs_activity\"}",
          "instant": true,
          "legendFormat": "activity",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Collection age",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
