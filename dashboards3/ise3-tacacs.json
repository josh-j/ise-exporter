{
  "annotations": {},
  "description": "Internal account hygiene, policy-set inventory, authentication, authorization, commands, operational-owner rollups, and bounded-device coverage.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "ise-exporter3"
      ],
      "targetBlank": false,
      "title": "ISE Exporter 3 dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
