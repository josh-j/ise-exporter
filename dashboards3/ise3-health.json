{
  "annotations": {},
  "description": "Collection readiness, failure detail, transport health, Data Connect cost, bounded-breakdown coverage, caches, and exporter identity.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "ise-exporter3"
      ],
      "targetBlank": false,
      "title": "ISE Exporter 3 dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": [],
      "title": "Dataset readiness",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Enabled, active-provider, up, fresh, and next-run state for every selected dataset.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataset_enabled{instance=~\"$deployment\",dataset=~\"$dataset\"}",
          "instant": true,
          "legendFormat": "{{dataset}} enabled",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "ise3_dataset_provider_active{instance=~\"$deployment\",dataset=~\"$dataset\"}",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{provider}} active",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "ise3_dataset_up{instance=~\"$deployment\",dataset=~\"$dataset\"}",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{provider}} up",
          "range": false,
          "refId": "C"
        },
        {
          "expr": "ise3_dataset_fresh{instance=~\"$deployment\",dataset=~\"$dataset\"}",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{provider}} fresh",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "Dataset collection status",
      "transformations": [],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "One bounded reason and operator explanation for each currently failing dataset.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataset_last_failure_detail_info{instance=~\"$deployment\",dataset=~\"$dataset\"}",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{provider}} \u00b7 {{reason}} \u00b7 {{detail}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Latest dataset failure",
      "transformations": [],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Time since each dataset last attempted collection and last completed successfully.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "time() - ise3_dataset_last_attempt_timestamp{instance=~\"$deployment\",dataset=~\"$dataset\"}",
          "instant": false,
          "legendFormat": "{{dataset}} attempt",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "time() - ise3_dataset_last_success_timestamp{instance=~\"$deployment\",dataset=~\"$dataset\"}",
          "instant": false,
          "legendFormat": "{{dataset}} success",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Collection attempt and success age",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Latest collection wall time by dataset and provider, used to find cadences the collector cannot sustain.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataset_collection_duration_seconds{instance=~\"$deployment\",dataset=~\"$dataset\"}",
          "instant": false,
          "legendFormat": "{{dataset}} \u00b7 {{provider}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Collection duration",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Current consecutive failures beside the rate of failures by bounded reason.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataset_consecutive_failures{instance=~\"$deployment\",dataset=~\"$dataset\"}",
          "instant": false,
          "legendFormat": "{{dataset}} consecutive",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "sum by (dataset,reason) (rate(ise3_dataset_failures_total{instance=~\"$deployment\",dataset=~\"$dataset\"}[15m]))",
          "instant": false,
          "legendFormat": "{{dataset}} \u00b7 {{reason}} rate",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Consecutive and cumulative failures",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Declared providers that cannot run and the bounded reason a lower-preference source was selected.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataset_provider_available{instance=~\"$deployment\",dataset=~\"$dataset\"}",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{provider}}",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "ise3_dataset_provider_reason_info{instance=~\"$deployment\",dataset=~\"$dataset\"}",
          "instant": true,
          "legendFormat": "{{dataset}} \u00b7 {{provider}} \u00b7 {{reason}}",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Provider availability and fallback reason",
      "transformations": [],
      "transparent": false,
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "id": 0,
      "panels": [],
      "title": "Reporting and transport",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
