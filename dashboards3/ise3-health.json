          "range": false,
          "refId": "B"
        }
      ],
      "title": "Data Connect source freshness",
      "transformations": [],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Missing required columns are dataset blockers; missing optional columns identify the exact dashboard breakdowns this ISE release or account cannot supply.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(1 - ise3_dataconnect_schema_column_available{instance=~\"$deployment\"}) > 0",
          "instant": true,
          "legendFormat": "{{requirement}} \u00b7 {{view}}.{{column}}",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "(1 - ise3_dataconnect_schema_view_available{instance=~\"$deployment\"}) > 0",
          "instant": true,
          "legendFormat": "missing view \u00b7 {{view}}",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Data Connect schema capability gaps",
      "transformations": [],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Statement execution rate by reporting view and result, exposing failing or unexpectedly busy views.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "ops"
        },
        "overrides": []
      },
