      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum by (view,result) (rate(ise3_dataconnect_queries_total{instance=~\"$deployment\"}[15m]))",
          "instant": false,
          "legendFormat": "{{view}} \u00b7 {{result}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Data Connect statements",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Most recent statement duration by reporting view and result, sorted by cost.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": []
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sort_desc(ise3_dataconnect_query_last_duration_seconds{instance=~\"$deployment\"})",
