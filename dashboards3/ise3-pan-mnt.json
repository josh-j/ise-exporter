{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "changes(ise3_dataset_provider_active{instance=~\"$deployment\"}[5m]) > 0",
        "hide": false,
        "iconColor": "purple",
        "name": "Provider changed",
        "step": "1m",
        "textFormat": "{{dataset}} is now served by {{provider}}",
        "titleFormat": "Provider changed: {{dataset}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "max by (instance,node) (changes(ise3_deployment_node_state{instance=~\"$deployment\"}[10m])) > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Node state changed",
        "step": "1m",
        "textFormat": "{{node}} changed deployment state",
        "titleFormat": "Node state changed: {{node}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "ise3_exporter_build_info{instance=~\"$deployment\"} unless (ise3_exporter_build_info{instance=~\"$deployment\"} offset 5m)",
        "hide": false,
        "iconColor": "blue",
        "name": "Exporter build changed",
        "step": "1m",
        "textFormat": "exporter {{version}} targeting ISE {{target_ise_release}}",
        "titleFormat": "Exporter build changed"
      }
    ]
  },
  "description": "Administrative and monitoring-node state, services, backup, certificates, posture cache, node resources, and collector failures.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "ise-exporter3"
      ],
      "targetBlank": false,
      "title": "ISE Exporter 3 dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": [],
      "title": "Deployment and services",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Freshness of deployment, performance, backup, certificates, patches, and current-posture data. NOT READY means the panels fed by that dataset stay blank.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "NOT READY"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "OK"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "no data \u2014 exporter absent?",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"deployment\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"deployment\"} == 1))) == bool 1) * ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"deployment\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"deployment\"} == 1))) == bool 1)",
          "instant": true,
          "legendFormat": "deployment",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"psn_performance\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"psn_performance\"} == 1))) == bool 1) * ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"psn_performance\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"psn_performance\"} == 1))) == bool 1)",
          "instant": true,
          "legendFormat": "performance",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"backup\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"backup\"} == 1))) == bool 1) * ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"backup\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"backup\"} == 1))) == bool 1)",
          "instant": true,
          "legendFormat": "backup",
          "range": false,
          "refId": "C"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"certificates\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"certificates\"} == 1))) == bool 1) * ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"certificates\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"certificates\"} == 1))) == bool 1)",
          "instant": true,
          "legendFormat": "certificates",
          "range": false,
          "refId": "D"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"patches\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"patches\"} == 1))) == bool 1) * ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"patches\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"patches\"} == 1))) == bool 1)",
          "instant": true,
          "legendFormat": "patches",
          "range": false,
          "refId": "E"
        },
        {
          "expr": "((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"posture_current\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"posture_current\"} == 1))) == bool 1) * ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"posture_current\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"posture_current\"} == 1))) == bool 1)",
          "instant": true,
          "legendFormat": "posture",
          "range": false,
          "refId": "F"
        }
      ],
      "title": "Core dataset readiness",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Seconds since the latest successful deployment, performance, and current-posture snapshots.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "time() - ise3_dataset_last_success_timestamp{instance=~\"$deployment\",dataset=\"deployment\"}",
          "instant": true,
          "legendFormat": "deployment",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "time() - ise3_dataset_last_success_timestamp{instance=~\"$deployment\",dataset=\"psn_performance\"}",
          "instant": true,
          "legendFormat": "performance",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "time() - ise3_dataset_last_success_timestamp{instance=~\"$deployment\",dataset=\"posture_current\"}",
          "instant": true,
          "legendFormat": "posture",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Core snapshot age",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Connected administrative and monitoring personas derived from the authoritative deployment snapshot.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "count(ise3_deployment_node_state{instance=~\"$deployment\",roles=~\".*(Admin|Standalone).*\",state=\"Connected\"} == 1)",
          "instant": true,
          "legendFormat": "PANs",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "count(ise3_deployment_node_state{instance=~\"$deployment\",roles=~\".*(Monitoring|Standalone).*\",state=\"Connected\"} == 1)",
          "instant": true,
          "legendFormat": "MnTs",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Connected PANs and MnTs",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Current state, persona roles, and service list for each selected core ISE node.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_deployment_node_state{instance=~\"$deployment\",node=~\"$node\",state=~\".*\"} == 1",
          "format": "table",
          "instant": true,
          "legendFormat": "{{node}} \u00b7 {{roles}} \u00b7 {{state}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "PAN and MnT node state",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time",
                "__name__",
                "job",
                "Value"
              ]
            }
          }
        }
      ],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Explicit services enabled on each selected administrative or monitoring node.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "enabled"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "index": 1,
                        "text": "No"
                      },
                      "1": {
                        "color": "green",
                        "index": 0,
                        "text": "Yes"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_deployment_node_service_enabled{instance=~\"$deployment\",node=~\"$node\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{node}} \u00b7 {{service}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Node service assignments",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time",
                "__name__",
                "job"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "enabled"
            }
          }
        }
      ],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Administrative HA state beside configured backup and latest successful backup age.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "orange",
                        "index": 1,
                        "text": "No"
                      },
                      "1": {
                        "color": "green",
                        "index": 0,
                        "text": "Yes"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "index": 1,
                        "text": "Not configured"
                      },
                      "1": {
                        "color": "green",
                        "index": 0,
                        "text": "Configured"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 26
                    },
                    {
                      "color": "red",
                      "value": 50
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_deployment_pan_ha_enabled{instance=~\"$deployment\"}",
          "instant": true,
          "legendFormat": "PAN HA",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "ise3_backup_configured{instance=~\"$deployment\"}",
          "instant": true,
          "legendFormat": "backup configured",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "ise3_backup_age_hours{instance=~\"$deployment\"}",
          "instant": true,
          "legendFormat": "backup age",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "PAN HA and backup",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Patch level, expired certificates, and near-term certificate expiry findings for core nodes.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_patch_level{instance=~\"$deployment\"}",
          "instant": true,
          "legendFormat": "patch",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "ise3_certificates_expired{instance=~\"$deployment\"}",
          "instant": true,
          "legendFormat": "expired",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "ise3_certificates_expiring_soon{instance=~\"$deployment\"}",
          "instant": true,
          "legendFormat": "expiring",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Patch and certificate findings",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Certificate expiry by selected node, store, usage, and certificate identity.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sort(ise3_certificate_expiry_days{instance=~\"$deployment\",node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{node}} \u00b7 {{store}} \u00b7 {{certificate}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Core-node certificate expiry",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time",
                "__name__",
                "job"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "days to expiry"
            }
          }
        }
      ],
      "transparent": false,
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 0,
      "panels": [],
      "title": "MnT session and posture coverage",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Current live-session count and distinct endpoints from the selected active provider.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 stale, see readiness",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum((ise3_active_sessions_total{instance=~\"$deployment\"}) and on(instance) (((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"active_sessions\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"active_sessions\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"active_sessions\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"active_sessions\"} == 1))) == 1)))",
          "instant": true,
          "legendFormat": "sessions",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "sum((ise3_active_session_endpoints{instance=~\"$deployment\"}) and on(instance) (((max by (instance) (ise3_dataset_up{instance=~\"$deployment\",dataset=\"active_sessions\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"active_sessions\"} == 1))) == 1) and ((max by (instance) (ise3_dataset_fresh{instance=~\"$deployment\",dataset=\"active_sessions\"} and on(instance,dataset,provider) (ise3_dataset_provider_active{instance=~\"$deployment\",dataset=\"active_sessions\"} == 1))) == 1)))",
          "instant": true,
          "legendFormat": "endpoints",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Active sessions",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Coverage and deferred endpoint-detail fetches shared by authorization and current-posture datasets.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_detail_cache_coverage{instance=~\"$deployment\",cache=\"mnt_session_detail\"}",
          "instant": true,
          "legendFormat": "coverage",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "ise3_detail_fetches_deferred{instance=~\"$deployment\",cache=\"mnt_session_detail\"}",
          "instant": true,
          "legendFormat": "deferred",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "MnT detail cache",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Distinct active endpoints by posture state and the operations owner responsible for their NAD.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": []
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "repeatDirection": "h",
      "targets": [
        {
