{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "changes(ise3_dataset_provider_active[5m]) > 0",
        "hide": false,
        "iconColor": "purple",
        "name": "Provider changed",
        "step": "1m",
        "textFormat": "{{dataset}} is now served by {{provider}}",
        "titleFormat": "Provider changed: {{dataset}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "max by (node) (changes(ise3_deployment_node_state[10m])) > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Node state changed",
        "step": "1m",
        "textFormat": "{{node}} changed deployment state",
        "titleFormat": "Node state changed: {{node}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "ise3_exporter_build_info unless (ise3_exporter_build_info offset 5m)",
        "hide": false,
        "iconColor": "blue",
        "name": "Exporter build changed",
        "step": "1m",
        "textFormat": "exporter {{version}} targeting ISE {{target_ise_release}}",
        "titleFormat": "Exporter build changed"
      }
    ]
  },
  "description": "Tier 4. Where does this deployment run out? Thirty-day trends for licence, fleet growth, node saturation, certificate runway and exporter budget. A planning dashboard, not an operational one.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "ise-exporter3"
      ],
      "targetBlank": false,
      "title": "ISE Exporter 3 dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": [],
      "title": "Licence",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Licence tiers ISE currently reports as non-compliant. Any value above zero is a procurement conversation with a deadline attached, not an operational one.",
      "fieldConfig": {
        "defaults": {
          "noValue": "none \u2014 nothing to see",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "count(((ise3_license_compliant) and on() (((max(ise3_dataset_up{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1))) == 0)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Licence tiers out of compliance",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Total endpoint inventory over the trend window. The primary driver of licence consumption, so its growth rate is the input to any capacity forecast.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 stale, see Collection pipeline",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(ise3_endpoints_total) and on() (((max(ise3_dataset_up{dataset=\"endpoint_inventory\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"endpoint_inventory\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"endpoint_inventory\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"endpoint_inventory\"} == 1))) == 1))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Endpoints",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "The highest concurrent session count seen across the trend window. Sizing is done against the peak, not the average, so this is the number that matters for node capacity.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 stale, see Collection pipeline",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max_over_time((sum((ise3_active_sessions_total) and on() (((max(ise3_dataset_up{dataset=\"active_sessions\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"active_sessions\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"active_sessions\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"active_sessions\"} == 1))) == 1))))[$__range:])",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Peak concurrent sessions",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Share of this dashboard's own datasets that both collected successfully and are inside their freshness window (certificates, endpoint_inventory, licensing). Below 100% means some panel here is blank or stale, and the pipeline dashboard says which.",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": false,
              "title": "Why \u2014 collection pipeline",
              "url": "/d/ise3-pipeline?${__url_time_range}"
            }
          ],
          "max": 1,
          "min": 0,
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "avg(((max by (dataset) (ise3_dataset_up{dataset=~\"licensing|endpoint_inventory|certificates\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=~\"licensing|endpoint_inventory|certificates\"} == 1))) == bool 1) * ((max by (dataset) (ise3_dataset_fresh{dataset=~\"licensing|endpoint_inventory|certificates\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=~\"licensing|endpoint_inventory|certificates\"} == 1))) == bool 1))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Data trustworthy",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Time since the least recently collected of this dashboard's datasets last succeeded. Every number on this page is at least this old; a value climbing past its collection interval means ISE is answering slowly or not at all.",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": false,
              "title": "Why \u2014 collection pipeline",
              "url": "/d/ise3-pipeline?${__url_time_range}"
            }
          ],
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max(time() - (max by (dataset) (ise3_dataset_last_success_timestamp{dataset=~\"licensing|endpoint_inventory|certificates\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=~\"licensing|endpoint_inventory|certificates\"} == 1))))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Collection age",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Consumption against each licence tier over the trend window. Read the gradient, not the value: the question this panel answers is when a tier runs out, not whether it has.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(ise3_license_consumption) and on() (((max(ise3_dataset_up{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1))",
          "instant": false,
          "legendFormat": "{{tier}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Licence consumption by tier",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Whether each tier is enabled, compliant, and what state ISE reports for it. The reference behind the consumption graph beside it.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Enabled"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "index": 1,
                        "text": "No"
                      },
                      "1": {
                        "color": "green",
                        "index": 0,
                        "text": "Yes"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Compliant"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "index": 1,
                        "text": "No"
                      },
                      "1": {
                        "color": "green",
                        "index": 0,
                        "text": "Yes"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(ise3_license_enabled) and on() (((max(ise3_dataset_up{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "(ise3_license_compliant) and on() (((max(ise3_dataset_up{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "(ise3_license_consumption) and on() (((max(ise3_dataset_up{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "C"
        },
        {
          "expr": "(ise3_license_compliance_state) and on() (((max(ise3_dataset_up{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"licensing\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"licensing\"} == 1))) == 1)) == 1",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "Licence state by tier",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time",
                "__name__",
                "job",
                "instance",
                "Value #D"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "Enabled",
              "Value #B": "Compliant",
              "Value #C": "Consumption",
              "state": "ISE state",
              "tier": "Tier"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Consumption"
              }
            ]
          }
        }
      ],
      "transparent": false,
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 0,
      "panels": [],
      "title": "Fleet growth",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Inventory over the trend window. A steady gradient is planning input; a step is an import or a purge and should be explained before it is extrapolated from.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(ise3_endpoints_total) and on() (((max(ise3_dataset_up{dataset=\"endpoint_inventory\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"endpoint_inventory\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"endpoint_inventory\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"endpoint_inventory\"} == 1))) == 1))",
          "instant": false,
          "legendFormat": "endpoints",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "(ise3_network_devices_total) and on() (((max(ise3_dataset_up{dataset=\"network_devices\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"network_devices\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"network_devices\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"network_devices\"} == 1))) == 1))",
          "instant": false,
          "legendFormat": "network devices",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Endpoint and device growth",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Live session count over the trend window. The peaks are what PSN sizing is done against; the troughs say how much of the estate is genuinely idle overnight.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum((ise3_active_sessions_total) and on() (((max(ise3_dataset_up{dataset=\"active_sessions\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"active_sessions\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"active_sessions\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"active_sessions\"} == 1))) == 1)))",
          "instant": false,
          "legendFormat": "sessions",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Concurrent sessions",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Peak CPU per node across the trend window. This is the panel that says whether a node is trending towards needing help, as opposed to the PSN dashboard, which says whether it needs help right now.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max by (node) ((ise3_node_cpu_utilization_percent) and on() (((max(ise3_dataset_up{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1) and ((max(ise3_dataset_fresh{dataset=\"psn_performance\"} and on(dataset,provider) (ise3_dataset_provider_active{dataset=\"psn_performance\"} == 1))) == 1)))",
          "instant": false,
          "legendFormat": "{{node}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Node saturation trend",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 0,
      "panels": [],
      "title": "Runway",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
