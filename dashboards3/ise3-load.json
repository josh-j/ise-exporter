{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "changes(ise3_dataset_provider_active{instance=~\"$deployment\"}[5m]) > 0",
        "hide": false,
        "iconColor": "purple",
        "name": "Provider changed",
        "step": "1m",
        "textFormat": "{{dataset}} is now served by {{provider}}",
        "titleFormat": "Provider changed: {{dataset}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "max by (instance,node) (changes(ise3_deployment_node_state{instance=~\"$deployment\"}[10m])) > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Node state changed",
        "step": "1m",
        "textFormat": "{{node}} changed deployment state",
        "titleFormat": "Node state changed: {{node}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "changes(ise3_exporter_build_info{instance=~\"$deployment\"}[15m]) > 0",
        "hide": false,
        "iconColor": "blue",
        "name": "Exporter build changed",
        "step": "1m",
        "textFormat": "exporter {{version}} targeting ISE {{target_ise_release}}",
        "titleFormat": "Exporter build changed"
      }
    ]
  },
  "description": "Planned load from provider declarations beside measured requests and database time, target ceilings, enforced pacing, and scheduler queues.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "ise-exporter3"
      ],
      "targetBlank": false,
      "title": "ISE Exporter 3 dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": [],
      "title": "Budget",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Planned load as a fraction of each declared target ceiling; above one is over budget.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_load_budget_utilisation{instance=~\"$deployment\"}",
          "instant": true,
          "legendFormat": "{{target}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Budget used",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Declared request cost beside the measured rate actually leaving the exporter.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_load_planned_requests_per_hour{instance=~\"$deployment\"}",
          "instant": false,
          "legendFormat": "{{target}} planned",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "rate(ise3_load_measured_requests_total{instance=~\"$deployment\"}[15m]) * 3600",
          "instant": false,
          "legendFormat": "{{target}} measured",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Requests per hour: planned against measured",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Configured request ceiling beside the rate currently enforced by the token bucket.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_load_budget_requests_per_hour{instance=~\"$deployment\"}",
          "instant": false,
          "legendFormat": "{{target}} ceiling",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "ise3_budget_enforced_requests_per_hour{instance=~\"$deployment\"}",
          "instant": false,
          "legendFormat": "{{target}} enforced",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Request ceiling and enforcement",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 0,
      "panels": [],
      "title": "Data Connect duty cycle",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Planned wall-clock share in Oracle beside measured statement time and the enforced ceiling.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_load_planned_duty_cycle_percent{instance=~\"$deployment\",target=\"oracle\"}",
          "instant": false,
          "legendFormat": "planned",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "rate(ise3_load_measured_db_seconds_total{instance=~\"$deployment\",target=\"oracle\"}[15m]) * 100",
          "instant": false,
          "legendFormat": "measured",
          "range": true,
          "refId": "B"
        },
        {
          "expr": "ise3_dataconnect_effective_duty_cycle_percent{instance=~\"$deployment\"}",
          "instant": false,
          "legendFormat": "ceiling",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Duty cycle: planned against measured",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Global wait after each statement, which is how the configured duty-cycle budget is enforced.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataconnect_query_cooldown_seconds{instance=~\"$deployment\"}",
          "instant": false,
          "legendFormat": "{{view}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Cooldown imposed on reporting datasets",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 0,
      "panels": [],
      "title": "Statement cost and scheduler",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Latest successful statement duration for every reporting view.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataconnect_query_last_duration_seconds{instance=~\"$deployment\",result=\"success\"}",
          "instant": false,
          "legendFormat": "{{view}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Statement duration by view",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Rows returned by each reporting statement after database-side aggregation.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataconnect_query_rows{instance=~\"$deployment\"}",
          "instant": false,
          "legendFormat": "{{view}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Rows returned by view",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Datasets waiting on each serialized target lane; sustained depth means cadence is not achievable.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_lane_queue_depth{instance=~\"$deployment\"}",
          "instant": false,
          "legendFormat": "{{target}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Lane queue depth",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Latest collection duration by dataset and active provider.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataset_collection_duration_seconds{instance=~\"$deployment\"}",
          "instant": false,
          "legendFormat": "{{dataset}} \u00b7 {{provider}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Collection duration by dataset",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 36,
  "style": "dark",
  "tags": [
    "ise",
    "ise-exporter3"
  ],
  "templating": {
    "list": [
      {
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "hide": 0,
        "id": "00000000-0000-0000-0000-000000000000",
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "prometheus",
        "query": "prometheus",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "hide": 0,
        "id": "00000000-0000-0000-0000-000000000000",
        "includeAll": true,
        "label": "Deployment",
        "multi": true,
        "name": "deployment",
        "query": "label_values(ise3_dataset_enabled, instance)",
        "skipUrlSync": false,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "ISE Exporter 3 \u2014 Load and Budget",
  "uid": "ise3-load"
}
