{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "changes(ise3_dataset_provider_active[5m]) > 0",
        "hide": false,
        "iconColor": "purple",
        "name": "Provider changed",
        "step": "1m",
        "textFormat": "{{dataset}} is now served by {{provider}}",
        "titleFormat": "Provider changed: {{dataset}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "max by (node) (changes(ise3_deployment_node_state[10m])) > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Node state changed",
        "step": "1m",
        "textFormat": "{{node}} changed deployment state",
        "titleFormat": "Node state changed: {{node}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "enable": true,
        "expr": "ise3_exporter_build_info unless (ise3_exporter_build_info offset 5m)",
        "hide": false,
        "iconColor": "blue",
        "name": "Exporter build changed",
        "step": "1m",
        "textFormat": "exporter {{version}} targeting ISE {{target_ise_release}}",
        "titleFormat": "Exporter build changed"
      }
    ]
  },
  "description": "Tier 3. What is this exporter costing the appliance, and does the measured cost match the declared cost? The panel set that catches a cost declaration drifting away from reality.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "ise-exporter3"
      ],
      "targetBlank": false,
      "title": "ISE Exporter 3 dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": [],
      "title": "Budget",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Share of the configured request budget the exporter is actually consuming. Above 80% there is no headroom for a backfill or a manual query; at 100% the scheduler is throttling and freshness starts to slip.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max(ise3_load_budget_utilisation)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Budget used",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "What the exporter is really asking ISE for, derived from the request counter rather than from the plan. The number to quote when someone asks what this exporter costs.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum(rate(ise3_load_measured_requests_total[1h]) * 3600)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Measured requests per hour",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "What the configuration says the exporter will cost. Read it against the measured figure beside it: a declaration that does not match reality is the one thing in this design that can quietly lie.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum(ise3_load_planned_requests_per_hour)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Declared requests per hour",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Share of wall-clock time the exporter's Oracle session is actually executing. This is the figure a database administrator will care about, and the one the appliance enforces against.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "ise3_dataconnect_effective_duty_cycle_percent",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Data Connect duty cycle",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Cumulative seconds the scheduler has spent waiting for budget rather than querying. Non-zero means the budget is binding: the exporter wanted to collect and was not allowed to.",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "auto"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum(rate(ise3_budget_wait_seconds_total[$__rate_interval]))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Throttle wait",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Whether the budget accounting is still filling its first window. While this is true the utilisation figures beside it are provisional rather than wrong.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "orange",
                  "index": 1,
                  "text": "No"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "Yes"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "no data \u2014 exporter absent?",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": []
        },
        "textMode": "value"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max(ise3_budget_warming)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Budget warming",
      "transformations": [],
      "transparent": false,
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 0,
      "panels": [],
      "title": "Declared against measured",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "The plan against reality against the ceiling. Measured exceeding declared means a cost declaration is wrong; measured touching enforced means the scheduler is being held back and collection intervals are effectively longer than configured.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum(ise3_load_planned_requests_per_hour)",
          "instant": false,
          "legendFormat": "declared",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "sum(rate(ise3_load_measured_requests_total[1h]) * 3600)",
          "instant": false,
          "legendFormat": "measured",
          "range": true,
          "refId": "B"
        },
        {
          "expr": "sum(ise3_budget_enforced_requests_per_hour)",
          "instant": false,
          "legendFormat": "enforced ceiling",
          "range": true,
          "refId": "C"
        },
        {
          "expr": "sum(ise3_load_budget_requests_per_hour)",
          "instant": false,
          "legendFormat": "configured budget",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Requests per hour: declared, measured, and enforced",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Planned Oracle duty cycle against what the session actually used, against the ceiling the budget allows. The Data Connect equivalent of the request comparison beside it, and the one an appliance will enforce hardest.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum(ise3_load_planned_duty_cycle_percent)",
          "instant": false,
          "legendFormat": "declared",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "ise3_dataconnect_effective_duty_cycle_percent",
          "instant": false,
          "legendFormat": "measured",
          "range": true,
          "refId": "B"
        },
        {
          "expr": "sum(ise3_load_budget_duty_cycle_percent)",
          "instant": false,
          "legendFormat": "allowed",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Duty cycle: declared, measured, and allowed",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 0,
      "panels": [],
      "title": "Where the cost goes",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Duration and row count of the last query against each reporting view, most expensive first. The list of candidates whenever the duty cycle needs to come down: one view usually dominates.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 3
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cooldown"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max by (view) (ise3_dataconnect_query_last_duration_seconds)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "ise3_dataconnect_query_rows",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "ise3_dataconnect_query_cooldown_seconds",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Statement cost by view",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time",
                "__name__",
                "job",
                "instance",
                "provider"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "Last duration",
              "Value #B": "Rows",
              "Value #C": "Cooldown",
              "view": "View"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Last duration"
              }
            ]
          }
        }
      ],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "How long each dataset takes to collect and how often it runs \u2014 duration over interval is the share of the schedule that dataset consumes. The cheapest saving is usually a long dataset on a short interval.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Interval"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max by (dataset) (ise3_dataset_collection_duration_seconds)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "ise3_dataset_interval_seconds",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "ise3_dataset_series",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Collection cost by dataset",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time",
                "__name__",
                "job",
                "instance",
                "provider"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "Duration",
              "Value #B": "Interval",
              "Value #C": "Series published",
              "dataset": "Dataset"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Duration"
              }
            ]
          }
        }
      ],
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Oracle seconds per second the exporter is consuming, against the hourly figure the configuration declared. A step in the measured line without a configuration change means a view's data volume grew.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum by (target) (rate(ise3_load_measured_db_seconds_total[$__rate_interval]))",
          "instant": false,
          "legendFormat": "measured {{target}}",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "sum(ise3_load_planned_db_seconds_per_hour) / 3600",
          "instant": false,
          "legendFormat": "declared",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Database time consumed",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "The distribution behind the last-duration column beside it. A p95 well above the typical last duration means one statement occasionally runs far longer than it usually does, which is what actually breaches a duty cycle.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (view,le) (rate(ise3_dataconnect_query_duration_seconds_bucket[$__rate_interval])))",
          "instant": false,
          "legendFormat": "{{view}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Statement duration, 95th percentile",
      "transformations": [],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
